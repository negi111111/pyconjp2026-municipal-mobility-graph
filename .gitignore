# Local secrets. Keep the single tracked template at the repository root.
.env
.env.*
!/.env.example
*.key
*.pem
secrets.*

# Public raw inputs are reproducible through each phase's download script.
/phase1/data/raw/
/phase2/data/raw/
/phase3/data/raw/

# Python and packaging artifacts at any depth.
**/__pycache__/
*.py[cod]
**/.venv/
**/venv/
**/.pytest_cache/
**/.ruff_cache/
**/*.egg-info/
**/.streamlit/secrets.toml
build/
dist/

# OS artifacts.
.DS_Store
Thumbs.db
