AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.6-luna
AZURE_OPENAI_TIMEOUT_SECONDS=120
AZURE_OPENAI_MAX_COMPLETION_TOKENS=8192
# Global/direct-call default: none, low, medium, high, or xhigh. Default is xhigh.
AZURE_OPENAI_REASONING_EFFORT=xhigh
# Role-specific defaults optimize normal Query latency without changing comparison quality.
# Planner defaults to high / 4096, Response to medium / 4096, Comparison to xhigh / 8192.
AZURE_OPENAI_PLANNER_REASONING_EFFORT=
AZURE_OPENAI_RESPONSE_REASONING_EFFORT=
AZURE_OPENAI_COMPARISON_REASONING_EFFORT=
AZURE_OPENAI_PLANNER_MAX_COMPLETION_TOKENS=
AZURE_OPENAI_RESPONSE_MAX_COMPLETION_TOKENS=
AZURE_OPENAI_COMPARISON_MAX_COMPLETION_TOKENS=
